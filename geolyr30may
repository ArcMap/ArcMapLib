              () => undefined
            );


        consoleWarnSpy =
          jest.spyOn(
            console,
            "warn"
          )
            .mockImplementation(
              () => undefined
            );


        consoleErrorSpy =
          jest.spyOn(
            console,
            "error"
          )
            .mockImplementation(
              () => undefined
            );
      }
