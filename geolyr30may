private clearRoutePlannerGraphics(mapView: any): void {
  if (!mapView?.graphics) {
    return;
  }

  const graphicsToRemove = mapView.graphics
    .toArray()
    .filter((graphic: any) =>
      graphic.attributes?.source === 'route-planner'
    );

  if (graphicsToRemove.length > 0) {
    mapView.graphics.removeMany(graphicsToRemove);
  }
}