private removeLayer(): void {
  const layer = this.wmsLayer;

  if (!layer) {
    return;
  }

  try {
    if (this.ancestorMap) {
      this.ancestorMap.removeLayer(layer);
    } else if (this.view?.map) {
      this.view.map.remove(layer);
    }
  } catch (error) {
    console.warn(
      "[arc-wms-layer] Error removing WMS layer:",
      error
    );
  }

  try {
    layer.destroy();
  } catch {
    // Layer may already be destroyed
  }

  this.wmsLayer = undefined;
}


type ArcMapElement = HTMLElement & {
  getViewInstance?: () => MapView | Promise<MapView>;
  getView?: () => MapView | Promise<MapView>;
  view?: MapView;

  addLayer?: (
    layer: __esri.Layer,
    element?: HTMLElement
  ) => void | Promise<void>;

  removeLayer: (
    layer: __esri.Layer
  ) => void | Promise<void>;
};


try {
  if (this.ancestorMap) {
    await this.ancestorMap.removeLayer(wmsLayer);
  } else if (this.view?.map) {
    this.view.map.remove(wmsLayer);
  }
} catch (removeError) {
  console.warn(
    "[arc-wms-layer] Failed to remove WMS layer:",
    removeError
  );
}

wmsLayer.destroy();