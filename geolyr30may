private triggerMapRefresh(): void {
  const view = this.ma.mapView();

  if (!view || !Number.isFinite(view.zoom)) {
    return;
  }

  const originalZoom = view.zoom;

  requestAnimationFrame(() => {
    view
      .goTo(
        {
          center: view.center,
          zoom: originalZoom + 0.01
        },
        {
          animate: true,
          duration: 100
        }
      )
      .then(() =>
        view.goTo(
          {
            center: view.center,
            zoom: originalZoom
          },
          {
            animate: true,
            duration: 100
          }
        )
      )
      .catch(() => {
        // Ignore interrupted navigation
      });
  });
}