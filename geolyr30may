        );
      }
    );


    /* ========================================================
     * 17
     * NO LAYER NAME
     * ========================================================
     */

    it(
      "should add WMSLayer when layerNames is not provided",
      async () => {

        const {
          arcMap,
          element
        } =
          mountComponent();


        element.service = {
          url:
            "https://example.com/wms"
        } as any;


        await waitForComponent(
          element
        );


        const layer =
          createdLayers[0];


        expect(
          layer.load
        ).toHaveBeenCalledTimes(
          1
        );


        /*
         * Since no specific layerNames were supplied,
         * findSublayerByName should not be needed.
         */
        expect(
          layer.findSublayerByName
        ).not.toHaveBeenCalled();


        expect(
          arcMap.addLayer
        ).toHaveBeenCalledWith(
          layer,
          element
        );
      }
    );


