     * ========================================================
     */

    it(
      "should return WMS layer id from getLayerId",
      async () => {

        const {
          element
        } =
          mountComponent();


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]
        } as any;


