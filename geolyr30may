
  const view = this.mapView();

  if (!view) {
    return;
  }

  const currentZoom = view.zoom;

  // Force ArcGIS to refresh the view
  view.goTo(
    {
      center: view.center,
      zoom: currentZoom + 0.001
    },
    {
      animate: false
    }
  ).then(() => {
    return view.goTo(
      {
        center: view.center,
        zoom: currentZoom
      },
      {
        animate: false
      }
    );
  }).catch(() => {});
}