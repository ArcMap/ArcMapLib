.legend-section {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
}

.legend-title {
  margin: 0;
  padding: 0.75rem 0.875rem;
  font-size: var(--uu-font-size-body-sm, 0.875rem);
  font-weight: 600;
  color: var(--uu-color-on-surface, inherit);
}

.legend-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  font-size: var(--uu-font-size-body-sm, 0.875rem);
}

/* Header row like UX */
.legend-table thead {
  background: var(
    --uu-color-surface-container,
    rgba(0, 0, 0, 0.025)
  );
}

.legend-th {
  height: 3rem;
  padding: 0 0.5rem;
  text-align: left;
  vertical-align: middle;
  font-weight: 600;
  color: var(--uu-color-on-surface, inherit);
  border: 0;
}

/*
 * First column contains:
 * [color square] [dBZ number]
 *
 * Push the dBZ heading so it lines up
 * with 65, 60, 55... rather than the square.
 */
.legend-th:first-child {
  width: 34%;
  padding-left: 4rem;
}

.legend-th:last-child {
  width: 66%;
}

/* UX has comfortable vertical spacing */
.legend-row {
  height: 2.9rem;

  &:hover {
    background: transparent;
  }
}

.legend-cell {
  padding: 0.25rem 0.5rem;
  vertical-align: middle;
  color: var(--uu-color-on-surface, inherit);
  border: 0;
  white-space: nowrap;
}

/* Square + dBZ number */
.legend-cell--dbz {
  padding-left: 1rem;
  white-space: nowrap;
}

/* Larger blocks like legacy/UX */
.legend-swatch {
  display: inline-block;
  width: 1.75rem;
  height: 1.75rem;
  margin-right: 1.25rem;
  vertical-align: middle;
  border-radius: 0;
  border: 1px solid rgba(0, 0, 0, 0.08);
}

/* Keep dBZ number vertically centered with square */
.legend-cell--dbz {
  line-height: 1.75rem;
}