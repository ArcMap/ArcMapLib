/** @jest-environment jsdom */

jest.mock(
  "@arcgis/core/layers/WMSLayer.js",
  () => ({
    __esModule: true,
    default: jest.fn()
  })
);

import WMSLayer from "@arcgis/core/layers/WMSLayer.js";

import {
  ArcWmsLayer
} from "./wms-layer";


/* ============================================================
 * TEST TYPES
 * ============================================================
 */

type MockSublayer = {
  id: number;
  name: string;
  title: string;
  visible?: boolean;
  legendUrl?: string;
};


type MockWmsLayer = {
  id: string;

  url: string;

  title:
    | string
    | null
    | undefined;

  visible: boolean;

  loaded: boolean;

  loadStatus: string;

  loadError:
    | Error
    | null;

  allSublayers:
    MockSublayer[];

  sublayers:
    MockSublayer[];

  load:
    jest.Mock;

  findSublayerByName:
    jest.Mock;

  findSublayerById:
    jest.Mock;

  destroy:
    jest.Mock;
};


type ArcMapTestElement =
  HTMLElement & {

    addLayer:
      jest.Mock;

    removeLayer:
      jest.Mock;
  };


/* ============================================================
 * ARC GIS MOCK
 * ============================================================
 */

const WMSLayerMock =
  WMSLayer as unknown as jest.Mock;


/*
 * Every WMSLayer created by the component
 * will be stored here.
 *
 * That allows tests to inspect:
 *
 * load()
 * destroy()
 * sublayers
 * findSublayerByName()
 * etc.
 */
let createdLayers:
  MockWmsLayer[] = [];


/*
 * Default WMS capabilities returned by our mocked WMS.
 */
const createDefaultSublayers =
  (): MockSublayer[] => [

    {
      id: 1,
      name: "roads",
      title: "Roads",
      visible: true
    },

    {
      id: 2,
      name: "cities",
      title: "Cities",
      visible: true
    },

    {
      id: 3,
      name: "states",
      title: "States",
      visible: true
    }
  ];


/*
 * Creates one fake ArcGIS WMSLayer.
 */
const createMockWmsLayer =
  (
    options: {
      url?: string;
      title?: string;
      visible?: boolean;
    }
  ): MockWmsLayer => {

    const allSublayers =
      createDefaultSublayers();


    const layer =
      {} as MockWmsLayer;


    layer.id =
      `mock-wms-${createdLayers.length + 1}`;


    layer.url =
      options.url ?? "";


    layer.title =
      options.title;


    layer.visible =
      options.visible ?? true;


    layer.loaded =
      false;


    layer.loadStatus =
      "not-loaded";


    layer.loadError =
      null;


    layer.allSublayers =
      allSublayers;


    layer.sublayers =
      [];


    /*
     * Mock WMSLayer.load()
     *
     * This represents a successful
     * GetCapabilities request.
     */
    layer.load =
      jest.fn()
        .mockImplementation(
          async () => {

            layer.loaded =
              true;

            layer.loadStatus =
              "loaded";

            return layer;
          }
        );


    /*
     * Mock:
     *
     * wmsLayer.findSublayerByName(...)
     */
    layer.findSublayerByName =
      jest.fn()
        .mockImplementation(
          (name: string) => {

            return allSublayers.find(
              sublayer =>
                sublayer.name === name
            );
          }
        );


    /*
     * Mock:
     *
     * wmsLayer.findSublayerById(...)
     */
    layer.findSublayerById =
      jest.fn()
        .mockImplementation(
          (id: number) => {

            return allSublayers.find(
              sublayer =>
                sublayer.id === id
            );
          }
        );


    /*
     * Mock destroy()
     */
    layer.destroy =
      jest.fn();


    return layer;
  };


/* ============================================================
 * HELPERS
 * ============================================================
 */


/*
 * Creates fake <arc-map>.
 *
 * We don't need the real ArcMap component
 * for unit testing arc-wms-layer.
 */
const createArcMap =
  (): ArcMapTestElement => {

    const arcMap =
      document.createElement(
        "arc-map"
      ) as ArcMapTestElement;


    arcMap.addLayer =
      jest.fn()
        .mockResolvedValue(
          undefined
        );


    arcMap.removeLayer =
      jest.fn()
        .mockResolvedValue(
          undefined
        );


    return arcMap;
  };


/*
 * Creates:
 *
 * <arc-map>
 *    <arc-wms-layer>
 * </arc-map>
 *
 * and attaches it to document.body.
 */
const mountComponent =
  (): {
    arcMap: ArcMapTestElement;
    element: ArcWmsLayer;
  } => {

    const arcMap =
      createArcMap();


    const element =
      document.createElement(
        "arc-wms-layer"
      ) as ArcWmsLayer;


    arcMap.appendChild(
      element
    );


    document.body.appendChild(
      arcMap
    );


    return {
      arcMap,
      element
    };
  };


/*
 * Allows Lit lifecycle + our asynchronous
 * updateLayer() / constructLayerAndAddToMap()
 * calls to finish.
 */
const flushAsync =
  async (): Promise<void> => {

    await Promise.resolve();

    await Promise.resolve();

    await new Promise<void>(
      resolve => {

        setTimeout(
          resolve,
          0
        );
      }
    );

    await Promise.resolve();
  };


const waitForComponent =
  async (
    element: ArcWmsLayer
  ): Promise<void> => {

    await element.updateComplete;

    await flushAsync();
  };


/* ============================================================
 * TESTS
 * ============================================================
 */

describe(
  "ArcWmsLayer",
  () => {

    let consoleLogSpy:
      jest.SpyInstance;

    let consoleWarnSpy:
      jest.SpyInstance;

    let consoleErrorSpy:
      jest.SpyInstance;


    beforeEach(
      () => {

        /*
         * Clean DOM.
