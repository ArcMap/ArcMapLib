effect(() => {
  const mapView = this.mapFacade.mapView();
  const routeRenderState =
    this.mapFacade.routePlannerRenderState();

  if (!mapView || !this.appMapInstance) {
    return;
  }

  this.applyRoutePlannerRenderState(
    mapView,
    routeRenderState
  );

  // -----------------------------
  // Main route
  // -----------------------------
  if ((routeRenderState?.routeLocations?.length ?? 0) > 1) {
    requestAnimationFrame(() => {
      const mapElement =
        this.appMapElement()?.nativeElement as HTMLElement | undefined;

      const routeElement = mapElement?.querySelector(
        'app-route#routePlannerRoute'
      );

      if (!routeElement) {
        return;
      }

      if (
        this.previousRouteElement &&
        this.previousRouteElement !== routeElement
      ) {
        routeElement.dispatchEvent(
          new CustomEvent('appMapDeferredReady', {
            detail: {
              map: mapView.map,
              view: mapView,
            },
            bubbles: false,
            composed: true,
          })
        );
      }

      this.previousRouteElement = routeElement;
    });
  } else {
    this.previousRouteElement = null;
  }

  // -----------------------------
  // Work-range highlighted route
  // -----------------------------
  if (
    (routeRenderState?.highlightedRouteLocations?.length ?? 0) > 1
  ) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const mapElement =
          this.appMapElement()?.nativeElement as HTMLElement | undefined;

        const highlightedRouteElement =
          mapElement?.querySelector(
            'app-route#routePlannerHighlightedRoute'
          );

        if (!highlightedRouteElement) {
          return;
        }

        // IMPORTANT:
        // Dispatch even when previousHighlightedRouteElement is null.
        // This element is dynamically created after map initialization.
        if (
          this.previousHighlightedRouteElement !==
          highlightedRouteElement
        ) {
          highlightedRouteElement.dispatchEvent(
            new CustomEvent('appMapDeferredReady', {
              detail: {
                map: mapView.map,
                view: mapView,
              },
              bubbles: false,
              composed: true,
            })
          );
        }

        this.previousHighlightedRouteElement =
          highlightedRouteElement;
      });
    });
  } else {
    this.previousHighlightedRouteElement = null;
  }
});