  const assetId = dt.payload.assetId;

  const initialCursor = getState().pageInfo.cursor;

  return defer(() =>

    this.TRS.GOH(assetId, initialCursor)

  ).pipe(

    // Keep fetching next pages

    expand((response: ObservationHistoryResponse) => {

      const OH = response.observationHistory;

      const pageInfo = OH?.pageInfo;

      if (!pageInfo?.hasNextPage || !pageInfo.cursor) {

        return EMPTY;

      }

      return this.TRS.GOH(

        assetId,

        pageInfo.cursor

      );

    }),

    // Get observations from every page

    map((response: ObservationHistoryResponse) => {

      const OH = response.observationHistory;

      return OH?.observations ?? [];

    }),

    // Combine observations from all pages

    reduce(

      (

        allObservations: Observation[],

        currentObservations: Observation[]

      ) => [

        ...allObservations,

        ...currentObservations

      ],

      [] as Observation[]

    ),

    /*

     * If the user clicks Cancel:

     * - active HTTP request is unsubscribed

     * - next page will not be requested

     * - tap below will not execute

     * - partial data will not be added to state

     */

    takeUntil(

      this.traceDataService.cancelOngoingRequest$

    ),

    tap((observations: Observation[]) => {

      const observationsInDateRange =

        observations.filter(observation => {

          const dateTimeInSeconds =

            new Date(

              observation.observationDateTime

            ).getTime() / 1000;

          return (

            dateTimeInSeconds >= dt.payload.startDate &&

            dateTimeInSeconds <= dt.payload.endDate

          );

        });

      setState(

        produce(getState(), draft => {

          draft.observations.push(

            ...observationsInDateRange

          );

          draft.observations = [

            ...new Set(draft.observations)

          ];

        })

      );

    }),

    catchError(err => {

      if (err instanceof HttpErrorResponse) {

        this.store.dispatch(

          new ShowErrorBanner(

            'Failed to load observations. Please try again.'

          )

        );

      }

      return throwError(() => err);

    })

  );

}