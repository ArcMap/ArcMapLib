

  const assetId = dt.payload.assetId;
  const initialCursor = getState().pageInfo.cursor;

  /*
   * Prevent the same cursor from being requested
   * more than once during this action execution.
   */
  const requestedCursors = new Set<string>();

  const getPage = (cursor?: string) => {
    const cursorKey = cursor ?? 'INITIAL';

    if (requestedCursors.has(cursorKey)) {
      console.warn(
        'Skipping duplicate observation request:',
        ast,
        cursor
      );

      return EMPTY;
    }

    requestedCursors.add(cursorKey);

    console.log(
      'Calling GOH:',
      assetId,
      cursor
    );

    return this.TRS
      .GOH(assetId, cursor)
      .pipe(
        takeUntil(
          this.tra.cancelOngoingRequest$
        )
      );
  };

  return getPage(initialCursor).pipe(

    expand((response: obhr) => {
      const OH = response.observat;
      const pageInfo = OH?.pageInfo;

      if (
        !pageInfo?.hasNextPage ||
        !pageInfo.cursor
      ) {
        return EMPTY;
      }

      return getPage(pageInfo.cursor);
    }),

    /*
     * Cancel the complete pagination chain.
     */
    takeUntil(
      this.tra.cancelOngoingRequest$
    ),

    map((response: Observati) => {
      const OH = response.observath;

      return OH?.observations ?? [];
    }),

    reduce(
      (
        allObservations: Observation[],
        currentObservations: Observation[]
      ) => [
        ...allObservations,
        ...currentObservations
      ],
      [] as Observation[]
    ),

    tap((observations: Observation[]) => {

      const observationsInDateRange =
        observations.filter(observation => {

          const dateTimeInSeconds =
            new Date(
              observation.observationDateTime
            ).getTime() / 1000;

          return (
            dateTimeInSeconds >=
              dt.payload.startDate &&
            dateTimeInSeconds <=
              dt.payload.endDate
          );
        });

      setState(
        produce(getState(), draft => {

          draft.observations.push(
            ...observationsInDateRange
          );

          draft.observations = [
            ...new Set(draft.observations)
          ];
        })
      );
    }),

    catchError(err => {
      if (err instanceof HttpErrorResponse) {
        this.store.dispatch(
          new ShowErrorBanner(
            'Failed to load observations. Please try again.'
          )
        );
      }

      return throwError(() => err);
    })
  );
}