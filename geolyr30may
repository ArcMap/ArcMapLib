.legend-section {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
}

.legend-title {
  margin: 0;
  font-size: var(--uu-font-size-body-sm, 0.875rem);
  font-weight: 600;
  color: var(--uu-color-on-surface, inherit);
}

.legend-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  font-size: var(--uu-font-size-body-sm, 0.875rem);

  border: 1px solid
    var(--uu-color-outline-variant, #ccc);
}

.legend-th {
  height: 2.75rem;
  padding: 0.25rem 0.5rem;
  text-align: left;
  vertical-align: middle;
  font-weight: 600;

  color: var(
    --uu-color-on-surface-variant,
    #444
  );

  border-right: 1px solid
    var(--uu-color-outline-variant, #ddd);

  border-bottom: 1px solid
    var(--uu-color-outline-variant, #ddd);
}

.legend-th:last-child {
  border-right: 0;
}

/* Color column */
.legend-th--color {
  width: 3.5rem;
}

/* dBZ column */
.legend-th--dbz {
  width: 4.5rem;
}

/* Rainrate takes remaining space */
.legend-th--rainrate {
  width: auto;
}

.legend-row {
  height: 2.75rem;

  &:hover {
    background-color: var(
      --uu-color-surface-container,
      rgba(0, 0, 0, 0.04)
    );
  }
}

.legend-cell {
  padding: 0.25rem 0.5rem;
  vertical-align: middle;
  white-space: nowrap;

  color: var(
    --uu-color-on-surface,
    inherit
  );

  /* Vertical divider between columns */
  border-right: 1px solid
    var(--uu-color-outline-variant, #ddd);

  /* No horizontal border between rows */
  border-bottom: 0;
}

.legend-cell:last-child {
  border-right: 0;
}

.legend-cell--color {
  text-align: center;
  padding-left: 0.5rem;
  padding-right: 0.5rem;
}

.legend-cell--dbz {
  text-align: left;
}

.legend-cell--rainrate {
  text-align: left;
}

.legend-swatch {
  display: inline-block;
  width: 1.5rem;
  height: 1.5rem;
  vertical-align: middle;
  border-radius: 0;

  border: 1px solid
    rgba(0, 0, 0, 0.1);
}