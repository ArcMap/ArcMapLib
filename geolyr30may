      }
    );


    /* ========================================================
     * 7
     * NO ARC-MAP ANCESTOR
     * ========================================================
     */

    it(
      "should not create WMSLayer when arc-map ancestor is missing",
      async () => {

        const element =
          document.createElement(
            "arc-wms-layer"
          ) as ArcWmsLayer;


        document.body.appendChild(
          element
        );


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]
        } as any;


        await waitForComponent(
          element
        );


        /*
         * constructLayerAndAddToMap()
         * must not be reached.
         */
        expect(
          WMSLayerMock
        ).not.toHaveBeenCalled();


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(
          expect.stringContaining(
            "must be a descendant of <arc-map>"
          )
        );
      }
    );


    /* ========================================================
     * 8
     * NUMERIC LAYER ID FALLBACK
     * ========================================================
     */

    it(
      "should fall back to findSublayerById for numeric layer name",
      async () => {

        const {
          arcMap,
          element
        } =
          mountComponent();


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "2"
          ]
        } as any;


        await waitForComponent(
          element
        );


        const layer =
          createdLayers[0];


        /*
         * First attempt by name.
         */
        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "2"
        );


        /*
         * Then numeric ID.
         */
        expect(
          layer.findSublayerById
        ).toHaveBeenCalledWith(
          2
        );


        /*
         * ID 2 = cities
         */
        expect(
          layer.sublayers
        ).toEqual(
          [
            layer.allSublayers[1]
          ]
        );


        expect(
          arcMap.addLayer
        ).toHaveBeenCalledWith(
          layer,
          element
        );
      }
    );


    /* ========================================================
     * 9
     * REQUESTED SUBLAYER NOT FOUND
     * ========================================================
     */

    it(
      "should not add WMSLayer when requested sublayer does not exist",
      async () => {

        const {
          arcMap,
          element
        } =
          mountComponent();


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "not-existing-layer"
          ]
        } as any;


        await waitForComponent(
          element
        );


        const layer =
          createdLayers[0];


        expect(
          layer.load
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "not-existing-layer"
        );


        /*
         * Nothing should reach the map.
         */
        expect(
          arcMap.addLayer
        ).not.toHaveBeenCalled();


        /*
         * Failed / unused ArcGIS layer
         * should be destroyed.
         */
        expect(
          layer.destroy
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(
          expect.stringContaining(
            "was NOT found"
          )
        );
      }
    );


    /* ========================================================
     * 10
     * WMS LOAD FAILURE
     * ========================================================
     */

    it(
      "should handle WMSLayer load failure",
      async () => {

        /*
         * Override only the next WMSLayer.
         */
        WMSLayerMock
          .mockImplementationOnce(
            (
              options: {
                url?: string;
                title?: string;
                visible?: boolean;
              }
            ) => {

              const layer =
                createMockWmsLayer(
                  options
                );


              const loadError =
                new Error(
                  "GetCapabilities failed"
                );


              layer.load =
                jest.fn()
                  .mockImplementation(
                    async () => {

                      layer.loadStatus =
                        "failed";

                      layer.loadError =
                        loadError;

                      throw loadError;
                    }
                  );


              createdLayers.push(
                layer
              );


              return layer;
            }
          );


        const {
          arcMap,
          element
        } =
          mountComponent();


        element.service = {
          url:
            "https://example.com/broken-wms",

          layerNames: [
            "roads"
          ]
        } as any;


        await waitForComponent(
          element
        );


        const layer =
          createdLayers[0];


        expect(
          layer.load
        ).toHaveBeenCalledTimes(
          1
        );


        /*
         * Failed WMS should not be added.
         */
        expect(
          arcMap.addLayer
        ).not.toHaveBeenCalled();


        expect(
          layer.destroy
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(
          "[arc-wms-layer] WMS BUILD FAILED"
        );
      }
    );


    /* ========================================================
     * 11
     * LEGEND URL
     * ========================================================
     */

    it(
      "should apply legendUrl to selected WMS sublayer",
      async () => {

        const {
          element
        } =
          mountComponent();


        element.legendUrl =
          "https://example.com/legend.png";


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]
        } as any;


        await waitForComponent(
          element
        );


        const layer =
          createdLayers[0];


        const roads =
          layer.allSublayers[0];


        expect(
          roads.legendUrl
        ).toBe(
          "https://example.com/legend.png"
        );
      }
    );


    /* ========================================================
     * 12
     * NAME UPDATE
     * ========================================================
     */

    it(
      "should update WMSLayer title when name changes",
      async () => {

        const {
          element
        } =
          mountComponent();


        element.name =
          "Original Name";


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]
        } as any;


        await waitForComponent(
          element
        );


        const layer =
          createdLayers[0];


        expect(
          layer.title
        ).toBe(
          "Original Name"
        );


        /*
         * Change only the Lit name property.
         * This should NOT recreate WMSLayer.
         */
        element.name =
          "Updated Name";


        await waitForComponent(
          element
        );


        expect(
          layer.title
        ).toBe(
          "Updated Name"
        );


        expect(
          WMSLayerMock
        ).toHaveBeenCalledTimes(
          1
        );
      }
    );


    /* ========================================================
     * 13
     * SERVICE CHANGE
     * ========================================================
     */

    it(
      "should remove old WMSLayer and create a new layer when service changes",
      async () => {

        const {
          arcMap,
          element
        } =
          mountComponent();


        /*
         * First WMS service.
         */
        element.service = {
          url:
            "https://example.com/wms-1",

          layerNames: [
            "roads"
          ]
        } as any;


        await waitForComponent(
          element
        );


        const firstLayer =
          createdLayers[0];


        expect(
          arcMap.addLayer
        ).toHaveBeenCalledWith(
          firstLayer,
          element
        );


        /*
         * Change WMS service.
         */
        element.service = {
          url:
            "https://example.com/wms-2",

          layerNames: [
            "cities"
          ]
        } as any;


        await waitForComponent(
          element
        );


        expect(
          createdLayers
        ).toHaveLength(
          2
        );


        const secondLayer =
          createdLayers[1];


        /*
         * Old layer removed.
         */
        expect(
          arcMap.removeLayer
        ).toHaveBeenCalledWith(
          firstLayer
        );


        expect(
          firstLayer.destroy
        ).toHaveBeenCalledTimes(
          1
        );


        /*
         * New layer uses new URL.
         */
        expect(
          secondLayer.url
        ).toBe(
          "https://example.com/wms-2"
        );


        /*
         * New layer added.
         */
        expect(
          arcMap.addLayer
        ).toHaveBeenCalledWith(
          secondLayer,
          element
        );


        expect(
          secondLayer.sublayers
        ).toEqual(
          [
            secondLayer.allSublayers[1]
          ]
        );
      }
    );


    /* ========================================================
     * 14
     * DISCONNECTED CALLBACK
     * ========================================================
     */

    it(
      "should remove and destroy WMSLayer when component is disconnected",
      async () => {

        const {
          arcMap,
          element
        } =
          mountComponent();


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]
        } as any;


        await waitForComponent(
          element
        );


        const layer =
          createdLayers[0];


        /*
         * Verify layer initially added.
         */
        expect(
          arcMap.addLayer
        ).toHaveBeenCalledWith(
          layer,
          element
        );


        /*
         * Trigger disconnectedCallback().
         */
        arcMap.removeChild(
          element
        );


        await flushAsync();


        expect(
          arcMap.removeLayer
        ).toHaveBeenCalledWith(
          layer
        );


        expect(
          layer.destroy
        ).toHaveBeenCalledTimes(
          1
