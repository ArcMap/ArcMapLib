/* ============================================================
 * MOCK ARCGIS WMSLayer
 * ============================================================
 */

jest.mock(
  "@arcgis/core/layers/WMSLayer.js",
  () => ({

    __esModule: true,

    default:
      jest.fn()
  })
);


import WMSLayer
  from "@arcgis/core/layers/WMSLayer.js";

import {
  ArcWmsLayer
} from "./wms-layer";


/* ============================================================
 * TYPES
 * ============================================================
 */

type MockWmsSublayer = {

  id: number;

  name: string;

  title: string;

  visible?: boolean;

  legendUrl?: string;
};


type MockWmsLayer = {

  id: string;

  url: string;

  title?:
    string | null;

  visible: boolean;

  loaded: boolean;

  loadStatus: string;

  loadError:
    Error | null;

  allSublayers:
    MockWmsSublayer[];

  sublayers:
    MockWmsSublayer[];

  load:
    jest.Mock;

  findSublayerByName:
    jest.Mock;

  findSublayerById:
    jest.Mock;

  destroy:
    jest.Mock;
};


type MockArcMap = {

  addLayer:
    jest.Mock;

  removeLayer:
    jest.Mock;
};


/* ============================================================
 * WMS CONSTRUCTOR MOCK
 * ============================================================
 */

const MockWMSLayerConstructor =
  WMSLayer as unknown as jest.Mock;


let createdLayers:
  MockWmsLayer[];


/* ============================================================
 * HELPERS
 * ============================================================
 */

const createSublayers =
  (): MockWmsSublayer[] => {

    return [

      {
        id: 1,
        name: "roads",
        title: "Roads",
        visible: true
      },

      {
        id: 2,
        name: "cities",
        title: "Cities",
        visible: true
      },

      {
        id: 3,
        name: "states",
        title: "States",
        visible: true
      }
    ];
  };


const createMockWmsLayer =
  (
    options: any
  ): MockWmsLayer => {

    const allSublayers =
      createSublayers();


    const layer =
      {} as MockWmsLayer;


    layer.id =
      `wms-${createdLayers.length + 1}`;


    layer.url =
      options?.url ?? "";


    layer.title =
      options?.title;


    layer.visible =
      options?.visible ?? true;


    layer.loaded =
      false;


    layer.loadStatus =
      "not-loaded";


    layer.loadError =
      null;


    layer.allSublayers =
      allSublayers;


    layer.sublayers =
      [];


    /* --------------------------------------------------------
     * Mock WMS GetCapabilities/load()
     * --------------------------------------------------------
     */

    layer.load =
      jest.fn()
        .mockImplementation(
          async () => {

            layer.loaded =
              true;

            layer.loadStatus =
              "loaded";

            return layer;
          }
        );


    /* --------------------------------------------------------
     * Mock findSublayerByName()
     * --------------------------------------------------------
     */

    layer.findSublayerByName =
      jest.fn()
        .mockImplementation(
          (
            name: string
          ) => {

            return allSublayers.find(
              sublayer =>
                sublayer.name === name
            );
          }
        );


    /* --------------------------------------------------------
     * Mock findSublayerById()
     * --------------------------------------------------------
     */

    layer.findSublayerById =
      jest.fn()
        .mockImplementation(
          (
            id: number
          ) => {

            return allSublayers.find(
              sublayer =>
                sublayer.id === id
            );
          }
        );


    /* --------------------------------------------------------
     * Mock destroy()
     * --------------------------------------------------------
     */

    layer.destroy =
      jest.fn();


    return layer;
  };


const createMockArcMap =
  (): MockArcMap => {

    return {

      addLayer:
        jest.fn()
          .mockResolvedValue(
            undefined
          ),

      removeLayer:
        jest.fn()
          .mockResolvedValue(
            undefined
          )
    };
  };


/**
 * Creates ArcWmsLayer without using document/customElements.
 *
 * closest("arc-map") is mocked directly.
 */
const createComponent =
  (
    arcMap:
      MockArcMap | null =
        createMockArcMap()
  ) => {

    const component =
      new ArcWmsLayer();


    (
      component as any
    ).closest =
      jest.fn()
        .mockImplementation(
          (
            selector: string
          ) => {

            if (
              selector ===
              "arc-map"
            ) {

              return arcMap;
            }

            return null;
          }
        );


    return {

      component,

      arcMap
    };
  };


/**
 * Calls private updateLayer().
 *
 * We intentionally test the actual component flow:
 *
 * updateLayer()
 *   -> parse service
 *   -> find arc-map
 *   -> constructLayerAndAddToMap()
 *   -> WMSLayer.load()
 *   -> sublayer lookup
 *   -> arcMap.addLayer()
 */
const runUpdate =
  async (
    component:
      ArcWmsLayer
  ): Promise<void> => {

    await (
      component as any
    ).updateLayer();
  };


/* ============================================================
 * TEST SUITE
 * ============================================================
 */

describe(
  "ArcWmsLayer",
  () => {

    let consoleLogSpy:
      jest.SpyInstance;

    let consoleWarnSpy:
      jest.SpyInstance;

    let consoleErrorSpy:
      jest.SpyInstance;


    beforeEach(
      () => {

        createdLayers =
          [];


        MockWMSLayerConstructor
          .mockReset();


        MockWMSLayerConstructor
          .mockImplementation(
            (
              options: any
            ) => {

              const layer =
                createMockWmsLayer(
                  options
                );


              createdLayers.push(
                layer
              );


              return layer;
            }
          );


        consoleLogSpy =
          jest.spyOn(
            console,
            "log"
          )
            .mockImplementation(
              () => undefined
            );


        consoleWarnSpy =
          jest.spyOn(
            console,
            "warn"
          )
            .mockImplementation(
              () => undefined
            );


        consoleErrorSpy =
          jest.spyOn(
            console,
            "error"
          )
            .mockImplementation(
              () => undefined
            );
      }
    );


    afterEach(
      () => {

        jest.restoreAllMocks();
      }
    );


    /* ========================================================
     * 1. CREATE WMS
     * ========================================================
     */

    it(
      "should create WMSLayer for valid service",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.name =
          "Road Layer";


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        expect(
          MockWMSLayerConstructor
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          MockWMSLayerConstructor
        ).toHaveBeenCalledWith(
          {

            url:
              "https://example.com/wms",

            title:
              "Road Layer",

            visible:
              true
          }
        );


        expect(
          createdLayers
        ).toHaveLength(
          1
        );


        expect(
          createdLayers[0].load
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          arcMap!.addLayer
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          arcMap!.addLayer
        ).toHaveBeenCalledWith(
          createdLayers[0],
          component
        );
      }
    );


    /* ========================================================
     * 2. FIND SUBLAYER BY NAME
     * ========================================================
     */

    it(
      "should find requested sublayer by name",
      async () => {

        const {
          component
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        const layer =
          createdLayers[0];


        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "roads"
        );


        expect(
          layer.sublayers
        ).toEqual(
          [
            layer.allSublayers[0]
          ]
        );
      }
    );


    /* ========================================================
     * 3. MULTIPLE SUBLAYERS
     * ========================================================
     */

    it(
      "should select multiple WMS sublayers",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads",
            "cities"
          ]

        } as any;


        await runUpdate(
          component
        );


        const layer =
          createdLayers[0];


        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "roads"
        );


        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "cities"
        );


        expect(
          layer.sublayers
        ).toEqual(
          [
            layer.allSublayers[0],
            layer.allSublayers[1]
          ]
        );


        expect(
          arcMap!.addLayer
        ).toHaveBeenCalledTimes(
          1
        );
      }
    );


    /* ========================================================
     * 4. NUMERIC ID FALLBACK
     * ========================================================
     */

    it(
      "should use sublayer id when numeric layer name is provided",
      async () => {

        const {
          component
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "2"
          ]

        } as any;


        await runUpdate(
          component
        );


        const layer =
          createdLayers[0];


        /*
         * First tries WMS name.
         */
        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "2"
        );


        /*
         * Since "2" wasn't a name,
         * falls back to numeric id.
         */
        expect(
          layer.findSublayerById
        ).toHaveBeenCalledWith(
          2
        );


        expect(
          layer.sublayers
        ).toEqual(
          [
            layer.allSublayers[1]
          ]
        );
      }
    );


    /* ========================================================
     * 5. SERVICE AS JSON STRING
     * ========================================================
     */

    it(
      "should parse service when provided as JSON string",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service =
          JSON.stringify(
            {

              url:
                "https://example.com/string-wms",

              layerNames: [
                "roads"
              ]
            }
          );


        await runUpdate(
          component
        );


        expect(
          MockWMSLayerConstructor
        ).toHaveBeenCalledWith(
          {

            url:
              "https://example.com/string-wms",

            title:
              undefined,

            visible:
              true
          }
        );


        expect(
          arcMap!.addLayer
        ).toHaveBeenCalledTimes(
          1
        );
      }
    );


    /* ========================================================
     * 6. INVALID JSON
     * ========================================================
     */

    it(
      "should not create layer for invalid service JSON",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service =
          "{invalid-json";


        await runUpdate(
          component
        );


        expect(
          MockWMSLayerConstructor
        ).not.toHaveBeenCalled();


        expect(
          arcMap!.addLayer
        ).not.toHaveBeenCalled();


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(

          expect.stringContaining(
            "Could not parse service JSON"
          ),

          expect.anything(),

          expect.anything()
        );
      }
    );


    /* ========================================================
     * 7. MISSING URL
     * ========================================================
     */

    it(
      "should not create WMS layer when url is missing",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service = {

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        expect(
          MockWMSLayerConstructor
        ).not.toHaveBeenCalled();


        expect(
          arcMap!.addLayer
        ).not.toHaveBeenCalled();


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(

          expect.stringContaining(
            "valid WMS url is required"
          )
        );
      }
    );


    /* ========================================================
     * 8. MISSING ARC-MAP
     * ========================================================
     */

    it(
      "should not create WMS layer when arc-map ancestor is missing",
      async () => {

        const {
          component
        } =
          createComponent(
            null
          );


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        expect(
          MockWMSLayerConstructor
        ).not.toHaveBeenCalled();


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(

          expect.stringContaining(
            "must be a descendant of <arc-map>"
          )
        );
      }
    );


    /* ========================================================
     * 9. SUBLAYER DOES NOT EXIST
     * ========================================================
     */

    it(
      "should not add layer when requested sublayer does not exist",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "unknown-layer"
          ]

        } as any;


        await runUpdate(
          component
        );


        const layer =
          createdLayers[0];


        expect(
          layer.load
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "unknown-layer"
        );


        expect(
          arcMap!.addLayer
        ).not.toHaveBeenCalled();


        expect(
          layer.destroy
        ).toHaveBeenCalled();


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(

          expect.stringContaining(
            "was NOT found"
          )
        );
      }
    );


    /* ========================================================
     * 10. WMS LOAD FAILURE
     * ========================================================
     */

    it(
      "should handle WMS load failure",
      async () => {

        const loadError =
          new Error(
            "GetCapabilities failed"
          );


        MockWMSLayerConstructor
          .mockImplementationOnce(
            (
              options: any
            ) => {

              const layer =
                createMockWmsLayer(
                  options
                );


              layer.load =
                jest.fn()
                  .mockImplementation(
                    async () => {

                      layer.loaded =
                        false;

                      layer.loadStatus =
                        "failed";

                      layer.loadError =
                        loadError;

                      throw loadError;
                    }
                  );


              createdLayers.push(
                layer
              );


              return layer;
            }
          );


        const {
          component,
          arcMap
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/broken-wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        const layer =
          createdLayers[0];


        expect(
          layer.load
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          arcMap!.addLayer
        ).not.toHaveBeenCalled();


        expect(
          layer.destroy
        ).toHaveBeenCalled();


        expect(
          consoleErrorSpy
        ).toHaveBeenCalledWith(
          "[arc-wms-layer] WMS BUILD FAILED"
        );
      }
    );


    /* ========================================================
     * 11. CUSTOM LEGEND
     * ========================================================
     */

    it(
      "should apply legend url to selected sublayer",
      async () => {

        const {
          component
        } =
          createComponent();


        component.legendUrl =
          "https://example.com/road-legend.png";


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        expect(
          createdLayers[0]
            .allSublayers[0]
            .legendUrl
        ).toBe(
          "https://example.com/road-legend.png"
        );
      }
    );


    /* ========================================================
     * 12. NO LAYER NAMES
     * ========================================================
     */

    it(
      "should add WMS when layerNames is not provided",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms"

        } as any;


        await runUpdate(
          component
        );


        const layer =
          createdLayers[0];


        expect(
          layer.load
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          layer.findSublayerByName
        ).not.toHaveBeenCalled();


        expect(
          arcMap!.addLayer
        ).toHaveBeenCalledWith(
          layer,
          component
        );
      }
    );


    /* ========================================================
     * 13. GET LAYER
     * ========================================================
     */

    it(
      "should return ArcGIS WMS layer from getLayer",
      async () => {

        const {
          component
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        expect(
          component.getLayer()
        ).toBe(
          createdLayers[0]
        );
      }
    );


    /* ========================================================
     * 14. GET LAYER ID
     * ========================================================
     */

    it(
      "should return WMS layer id",
      async () => {

        const {
          component
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        expect(
          await component.getLayerId()
        ).toBe(
          "wms-1"
        );
      }
    );


    /* ========================================================
     * 15. REMOVE LAYER
     * ========================================================
     */

    it(
      "should remove and destroy existing WMS layer",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service = {

          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        const layer =
          createdLayers[0];


        await (
          component as any
        ).removeLayer();


        expect(
          arcMap!.removeLayer
        ).toHaveBeenCalledWith(
          layer
        );


        expect(
          layer.destroy
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          component.getLayer()
        ).toBeUndefined();
      }
    );


    /* ========================================================
     * 16. CHANGE SERVICE
     * ========================================================
     */

    it(
      "should remove old layer and create new layer when service changes",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        /* First service */

        component.service = {

          url:
            "https://example.com/wms-1",

          layerNames: [
            "roads"
          ]

        } as any;


        await runUpdate(
          component
        );


        const firstLayer =
          createdLayers[0];


        /* Second service */

        component.service = {

          url:
            "https://example.com/wms-2",

          layerNames: [
            "cities"
          ]

        } as any;


        await runUpdate(
          component
        );


        expect(
          createdLayers
        ).toHaveLength(
          2
        );


        const secondLayer =
          createdLayers[1];


        expect(
          arcMap!.removeLayer
        ).toHaveBeenCalledWith(
          firstLayer
        );


        expect(
          firstLayer.destroy
        ).toHaveBeenCalled();


        expect(
          secondLayer.url
        ).toBe(
          "https://example.com/wms-2"
        );


        expect(
          secondLayer.sublayers
        ).toEqual(
          [
            secondLayer.allSublayers[1]
          ]
        );


        expect(
          arcMap!.addLayer
        ).toHaveBeenCalledWith(
          secondLayer,
          component
        );
      }
    );


    /* ========================================================
     * 17. EMPTY SERVICE
     * ========================================================
     */

    it(
      "should not construct WMS layer when service is undefined",
      async () => {

        const {
          component,
          arcMap
        } =
          createComponent();


        component.service =
          undefined;


        await runUpdate(
          component
        );


        expect(
          MockWMSLayerConstructor
        ).not.toHaveBeenCalled();


        expect(
          arcMap!.addLayer
        ).not.toHaveBeenCalled();
      }
    );
  }
);