describe("parseAndValidateRoute", () => {
  let consoleSpy: jest.SpyInstance;

  beforeEach(() => {
    consoleSpy = jest
      .spyOn(console, "error")
      .mockImplementation(() => {});
  });

  afterEach(() => {
    consoleSpy.mockRestore();
  });

  it("returns parsed array if valid", () => {
    (
      ValidationService.isValidRoutingLocationArray as unknown as jest.Mock
    ).mockReturnValue(true);

    const arr: RoutingLocation[] = [
      {
        type: "latlon",
        Location: {
          lat: 1,
          lon: 2
        }
      }
    ];

    expect(upRoute["parseAndValidateRoute"](arr)).toEqual(arr);
  });

  it("parses JSON string and returns array if valid", () => {
    (
      ValidationService.isValidRoutingLocationArray as unknown as jest.Mock
    ).mockReturnValue(true);

    const arr: RoutingLocation[] = [
      {
        type: "latlon",
        Location: {
          lat: 1,
          lon: 2
        }
      }
    ];

    expect(
      upRoute["parseAndValidateRoute"](JSON.stringify(arr))
    ).toEqual(arr);
  });

  it("returns [] if not valid", () => {
    (
      ValidationService.isValidRoutingLocationArray as unknown as jest.Mock
    ).mockReturnValue(false);

    expect(
      upRoute["parseAndValidateRoute"]([])
    ).toEqual([]);
  });

  it("returns [] if input is not array or string", () => {
    expect(
      upRoute["parseAndValidateRoute"](123 as any)
    ).toEqual([]);
  });

  it("returns [] if JSON string is invalid", () => {
    expect(
      upRoute["parseAndValidateRoute"]("not json")
    ).toEqual([]);
  });
});