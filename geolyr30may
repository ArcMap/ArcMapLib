        expect(
          registeredElement
        ).toBeDefined();
      }
    );


    /* ========================================================
     * 2
     * VALID SERVICE
     * ========================================================
     */

    it(
      "should create and load WMSLayer for a valid service",
      async () => {

        const {
          arcMap,
          element
        } =
          mountComponent();


        element.name =
          "Road WMS";


        element.service = {
          url:
            "https://example.com/wms",

          layerNames: [
            "roads"
          ]
        } as any;


        await waitForComponent(
          element
        );


        /*
         * Verify new WMSLayer(...)
         */
        expect(
          WMSLayerMock
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          WMSLayerMock
        ).toHaveBeenCalledWith(
          {
            url:
              "https://example.com/wms",

            title:
              "Road WMS",

            visible:
              true
          }
        );


        const layer =
          createdLayers[0];


        /*
         * GetCapabilities / load
         */
        expect(
          layer.load
        ).toHaveBeenCalledTimes(
          1
        );


        /*
         * Requested layer
         */
        expect(
          layer.findSublayerByName
        ).toHaveBeenCalledWith(
          "roads"
        );


        /*
         * Only roads selected.
         */
        expect(
          layer.sublayers
        ).toEqual(
          [
            layer.allSublayers[0]
          ]
        );


        /*
         * Added through arc-map.
         */
        expect(
          arcMap.addLayer
        ).toHaveBeenCalledTimes(
          1
        );


        expect(
          arcMap.addLayer
        ).toHaveBeenCalledWith(
          layer,
          element
        );
      }
    );


