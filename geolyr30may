constructor() {
  effect((onCleanup) => {
    const enabled = this.enabled();
    const paused = this.isPaused();

    console.log('[DO EFFECT]', {
      enabled,
      paused
    });

    if (!enabled || paused) {
      console.log('[DO NO TIMER]');
      return;
    }

    console.log('[DO TIMER START]');

    const subscription = interval(ANIMATION_INTERVAL_MS)
      .subscribe(() => {

        // Defensive check
        if (this.isPaused() || !this.enabled()) {
          console.log('[DO TICK BLOCKED]', {
            paused: this.isPaused(),
            enabled: this.enabled()
          });
          return;
        }

        const next =
          (this.currentFrameIndex() + 1) %
          FRAME_DELTAS_MINUTES.length;

        this.currentFrameIndex.set(next);

        if (next === 0) {
          this.nowMs.set(Date.now());
        }

        console.log(
          '[DOFRAME]',
          next,
          DOFRAME_LAYER_NAMES[next],
          'paused',
          this.isPaused()
        );

        this.frameChange.emit(
          DOFRAME_LAYER_NAMES[next]
        );
      });

    // CRITICAL:
    // Runs when paused/enabled changes AND when component is destroyed.
    onCleanup(() => {
      console.log('[DO TIMER CLEANUP]');
      subscription.unsubscribe();
    });
  });
}