private static counter = 0;

private readonly instanceId =
  ++Do.counter;

effect((onCleanup) => {
  const enabled = this.enabled();
  const paused = this.isPaused();

  console.log(
    `[DO INSTANCE ${this.instanceId}] EFFECT`,
    { enabled, paused }
  );

  if (!enabled || paused) {
    console.log(
      `[D INSTANCE ${this.instanceId}] NO TIMER`
    );
    return;
  }

  const subscription =
    interval(ANIMATION_INTERVAL_MS).subscribe(() => {

      console.log(
        `[DO INSTANCE ${this.instanceId}] DOFRAME`,
        this.currentFrameIndex(),
        'paused =',
        this.isPaused()
      );

      if (this.isPaused() || !this.enabled()) {
        return;
      }

      // existing frame code...
    });

  onCleanup(() => {
    console.log(
      `[DO INSTANCE ${this.instanceId}] CLEANUP`
    );

    subscription.unsubscribe();
  });
});


togglePlayPause(): void {
  const nowPaused = !this.isPaused();

  console.log(
    `[DO INSTANCE ${this.instanceId}] CLICK`,
    {
      before: this.isPaused(),
      after: nowPaused
    }
  );

  this.isPaused.set(nowPaused);
  this.pauseChange.emit(nowPaused);
}
